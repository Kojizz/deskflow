POSTGRES_PASSWORD=replace-with-a-random-password
RABBITMQ_PASSWORD=replace-with-a-random-password
# 32 random bytes encoded as base64. Generate with scripts/setup.ps1.
APP_ENCRYPTION_KEY=
APP_PORT=8088
# Set to the frontend origin; local launcher defaults to its selected frontend port.
# Docker default: http://localhost:8088. Current native frontend: http://127.0.0.1:5174.
APP_PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Local email is captured by Mailpit at http://127.0.0.1:8025.
# Set these for a real SMTP provider when deploying.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_SSL=false
ACCOUNT_MAIL_FROM=accounts@deskflow.local
